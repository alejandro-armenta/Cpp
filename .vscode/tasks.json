{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "ale builder",
            // The magic is here: compiling, then running the binary sequentially
            "command": "g++ -g -std=c++20 -Wall \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,       // Hides the long compiler command text
                "reveal": "always",
                "focus": false,       // Jumps cursor to terminal directly for inputs
                "panel": "shared",   // Reuses the identical pane over and over
                "clear": false,       // Wipes old output text completely before building
                "showReuseMessage": false
            }
        }
    ]
}
